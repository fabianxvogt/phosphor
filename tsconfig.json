{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["*.js", "*.mjs", "scripts/**/*.mjs", "tests/browser/**/*.mjs"],
  "exclude": ["dist", "node_modules", "artifacts"]
}
